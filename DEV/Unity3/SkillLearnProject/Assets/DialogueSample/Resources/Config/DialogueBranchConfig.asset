    legacyId: 
    legacyNextId: 
    end: 0
    choices: []
    speaker: "\uC5EC\uD589\uC790"
    sprite: {fileID: 21300000, guid: fa0ddd4440e3ad7428bf82f091122c43, type: 2}
    text: "\uB9C8\uC744\uC5D0\uC11C \uC5EC\uAD00\uC744 \uBC1C\uACAC\uD588\uC2B5\uB2C8\uB2E4.
      Save\uB85C \uC774 \uACBD\uB85C\uB97C \uC800\uC7A5\uD560 \uC218 \uC788\uC5B4\uC694."
  - nodeId: 10000003
    nextNodeId: 0
    legacyId: 
    legacyNextId: 
    end: 1
    choices: []
    speaker: "\uC548\uB0B4\uC790"
    sprite: {fileID: 21300000, guid: 2237d9623477b8b46826518a9324a51e, type: 2}
    text: "\uC232 \uD0D0\uD5D8\uC744 \uB9C8\uCCE4\uC2B5\uB2C8\uB2E4. Previous\uB85C
      \uC120\uD0DD \uC9C0\uC810\uAE4C\uC9C0 \uB3CC\uC544\uAC08 \uC218 \uC788\uC2B5\uB2C8\uB2E4."
  - nodeId: 10000004
    nextNodeId: 0
    legacyId: 
    legacyNextId: 
    end: 1
    choices: []
    speaker: "\uC548\uB0B4\uC790"
    sprite: {fileID: 21300000, guid: 2237d9623477b8b46826518a9324a51e, type: 2}
    text: "\uB9C8\uC744\uC5D0\uC11C \uC26C\uC5B4\uAC11\uB2C8\uB2E4. Finish\uB97C
      \uB204\uB974\uBA74 \uB300\uD654\uAC00 \uC885\uB8CC\uB429\uB2C8\uB2E4."
