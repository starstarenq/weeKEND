    choices: []
    speaker: "\uC5EC\uD589\uC790"
    sprite: {fileID: 21300000, guid: fa0ddd4440e3ad7428bf82f091122c43, type: 2}
    text: "\uC232\uC5D0\uC11C \uC624\uB798\uB41C \uC9C0\uB3C4\uB97C \uCC3E\uC558\uC2B5\uB2C8\uB2E4.
      Save\uB85C \uC774 \uACBD\uB85C\uB97C \uC800\uC7A5\uD560 \uC218 \uC788\uC5B4\uC694."
  - nodeId: 10000002
