{
    "m_SGVersion": 1,
    "m_Type": "UnityEditor.ShaderGraph.CustomFunctionNode",
    "m_ObjectId": "c65754321fd64a1cb7cec5ee7f0b479a",
    "m_Group": {
        "m_Id": ""
    },
    "m_Name": "SkillTelegraph (Custom Function)",
    "m_DrawState": {
        "m_Expanded": true,
        "m_Position": {
            "serializedVersion": "2",
            "x": 0.0,
            "y": 0.0,
            "width": 220.0,
            "height": 150.0
        }
    },
    "m_Slots": [
        {
            "m_Id": "106b3fb6f5a24318a3a1234cb75a1aee"
        },
        {
            "m_Id": "f3850874f19e450f9d1313b2bec1d422"
        },
        {
            "m_Id": "310a242e38b64bd7b4a860fbe2a74228"
        },
        {
            "m_Id": "456d278e543a47cd8e57e1e8aee76155"
        },
        {
            "m_Id": "e98cc1b6db1e4375bd6a0a9f4b3b05c9"
        },
        {
            "m_Id": "4da5f1b9892d41da9d6bf0b932296f5c"
        },
        {
            "m_Id": "0472de8eb60c4424b8e557db5fb386dc"
        },
        {
            "m_Id": "49ad8f2e8ce84a59a3d7c2fbbe459aaa"
        },
        {
            "m_Id": "77c1d6b67eaf406e912892e428d7e6f5"
        },
        {
            "m_Id": "0942de3e795048f2a1625f0628bf508f"
        },
        {
            "m_Id": "90c70e082f26408da7a15c93c9e06399"
        }
    ],
    "synonyms": [
        "code",
        "HLSL"
    ],
    "m_Precision": 0,
    "m_PreviewExpanded": true,
    "m_DismissedVersion": 0,
    "m_PreviewMode": 0,
    "m_CustomColors": {
        "m_SerializableColors": []
    },
    "m_SourceType": 1,
    "m_FunctionName": "SkillTelegraph",
    "m_FunctionSource": "",
    "m_FunctionSourceUsePragmas": true,
    "m_FunctionBody": "float2 p = UV * 2.0 - 1.0;\nfloat r = length(p);\nfloat a = abs(atan2(p.x, p.y));\nfloat halfAngle = radians(clamp(Angle, 1.0, 359.0) * 0.5);\nfloat sd = r - 1.0;\nfloat travel = r;\nif (Shape > 0.5 && Shape < 1.5) { sd = max(abs(p.x), abs(p.y)) - 1.0; travel = UV.y; }\nif (Shape > 1.5 && Shape < 2.5) { sd = max(sd, (a - halfAngle) * max(r, 0.001)); }\nif (Shape > 2.5) { sd = max(sd, Inner - r); travel = saturate((r - Inner) / max(1.0 - Inner, 0.01)); }\nfloat aa = max(fwidth(sd), 0.002);\nfloat mask = 1.0 - smoothstep(-aa, aa, sd);\nfloat edge = mask * smoothstep(-Border - aa, -Border + aa, sd);\nfloat fill = (1.0 - smoothstep(Progress - 0.012, Progress + 0.012, travel)) * step(0.001, Progress);\nfloat front = (1.0 - smoothstep(0.0, 0.022, abs(travel - Progress))) * step(0.001, Progress);\nfloat accents = 0.0;\nif (Shape > 0.5 && Shape < 1.5) {\n    float chevron = abs(frac(UV.y * 4.0 + abs(p.x) * 0.32) - 0.5);\n    accents = (1.0 - smoothstep(0.02, 0.045, chevron)) * 0.25 * fill;\n}\nColor = lerp(Tint.rgb, float3(1,1,1), saturate(edge * 0.3 + front * 0.35 + Impact * 0.8));\nAlpha = saturate(mask * (0.08 + fill * 0.3 + front * 0.4 + accents + Impact * 0.32) + edge * 0.8) * Tint.a * Opacity;\n"
}

